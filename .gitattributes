# AppImage launcher runs on Linux; a CRLF checkout would break its shebang.
tools/appimage/AppRun text eol=lf
tools/appimage/*.desktop text eol=lf

# Career 1.9 ships its encrypted sound packs through Git LFS. Raw audio stays
# local. music.pak carries the music/ subtree split out of sounds.pak so a
# sound-only change does not drag the much larger music payload with it.
src/freight_fate/sounds.pak filter=lfs diff=lfs merge=lfs -text
src/freight_fate/music.pak filter=lfs diff=lfs merge=lfs -text
